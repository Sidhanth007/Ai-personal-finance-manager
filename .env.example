# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. Only this example file is tracked.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3020
# Single admin account. Only this email gets the admin dashboard.
ADMIN_EMAIL=you@example.com

# --- Neon Postgres (Phase 3) ---
# Pooled connection string from the Neon console ("Connect" button, pooled on).
DATABASE_URL=

# --- Auth session signing (Phase 4). Random 32+ character string. ---
AUTH_SECRET=

# --- Brevo (Phase 4/10/13) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Finance Manager

# --- Google Gemini via AI Studio (Phase 12) ---
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional override. Google rotates which models the free tier serves; gemini-3.6-flash is the default.
GEMINI_MODEL=

# --- Stripe TEST MODE ONLY (Phase 14) ---
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=

# --- Upstash Redis rate limiting (Phase 17) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron protection (Phase 10/13). Random long string. ---
CRON_SECRET=
